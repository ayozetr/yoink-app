# Rust build output (Cargo.lock IS committed — these are apps, not libraries).
target/

# Logs
*.log
logs/

# Python caches (build scripts + any tooling)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Bundled binaries, built locally and never committed:
#   backend/  → the minimal ffmpeg/ffprobe (scripts/build_ffmpeg.sh)
#   /build/   → the ffmpeg minimal-build work dir
backend/
/build/

# JS tooling output for desktop-minter/web and extension/ (both use vite/npm).
# NOTE: desktop-minter/web/dist/minter.js is committed on purpose (include_str!),
# so it is re-included below — only the other build artifacts are ignored.
node_modules/
dist/
!desktop-minter/web/dist/
!desktop-minter/web/dist/minter.js
extension/web-ext-artifacts/
# AMO / Web Store API credentials (never commit) — template is .env.example
extension/.env

# Env / secrets
.env
*.local

# Downloaded media / local scratch (personal, never committed)
downloads/
URLs.txt

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# Local leftovers from the old React + Tauri stack (deleted from the repo, may
# still sit on an old working copy — never commit them).
src-tauri/
dist-ssr/
test-results/
playwright-report/
blob-report/
.playwright/
