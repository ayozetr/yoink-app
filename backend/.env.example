# Yoink backend settings (all optional). Copy to `.env` and edit as needed.
# Settings are read with the YOINK_ prefix.

# Where downloaded media is written (default: ~/Downloads/Yoink)
# YOINK_DOWNLOAD_DIR=/home/me/Downloads/Yoink

# Where app data (the SQLite history DB) lives (default: ~/.yoink)
# YOINK_DATA_DIR=/home/me/.yoink

# --- Cookies (only needed for sign-in-only content; NOT for public videos) ---
# Option A: read cookies straight from a local browser (most convenient).
#   Value is a browser name: firefox | chrome | chromium | brave | edge | opera | vivaldi | safari
# YOINK_COOKIES_FROM_BROWSER=firefox
#
# Option B: point to a Netscape-format cookies.txt exported with a browser
# extension (e.g. "Get cookies.txt LOCALLY" for Chrome, "cookies.txt" for Firefox):
# log in to the site, open the extension on that tab, Export.
#   cookies_from_browser takes precedence over cookies_file if both are set.
# YOINK_COOKIES_FILE=/home/me/.yoink/cookies.txt
