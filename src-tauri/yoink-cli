#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# /usr/bin/yoink-cli — forward to the bundled yoink-core in CLI mode, pointing it
# at the sibling yt-dlp/ffmpeg (what the Tauri shell sets when it serves the API).
set -eu
for dir in /usr/lib/Yoink/core /usr/lib/yoink/core /opt/Yoink/core; do
  if [ -x "$dir/yoink-core" ]; then
    export YOINK_YTDLP="$dir/yt-dlp"
    export YOINK_FFMPEG="$dir"
    exec "$dir/yoink-core" "$@"
  fi
done
echo "yoink-cli: bundled yoink-core not found" >&2
exit 1
