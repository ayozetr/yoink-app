{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yoink",
  "version": "1.2.0",
  "identifier": "app.yoink.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Yoink",
        "width": 1200,
        "height": 800,
        "minWidth": 520,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "© ayozetr",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yoink-backend"],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NEFDRERDQzQwMjc3N0EKUldSNmR3TEUzTTFLaVhKWDdVZmRWUXRhUVZTTFVUcnFGL0srTnZxOW9MdytvSmR2amJpb2gwcDkK",
      "endpoints": [
        "https://github.com/ayozetr/yoink-app/releases/latest/download/latest.json"
      ]
    }
  }
}
