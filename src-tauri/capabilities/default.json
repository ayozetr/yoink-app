{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Yoink window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "os:default",
    "process:default",
    "notification:default",
    "core:window:allow-set-progress-bar",
    "autostart:default",
    "global-shortcut:default"
  ]
}
