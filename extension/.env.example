# AMO (addons.mozilla.org) API credentials for `./build.sh publish-firefox`.
# Get them at: addons.mozilla.org -> Developer Hub -> Manage API Keys.
# Copy this file to `.env` (git-ignored) and fill in your own values.

AMO_JWT_ISSUER=user:XXXXXXXX:XXX
AMO_JWT_SECRET=your-long-secret-here

# listed  = public Firefox Add-ons store (auto-updates users)
# unlisted = AMO-signed .xpi you self-host
AMO_CHANNEL=listed
